-- Bu değişken, buton zaten eklenmiş mi kontrolü için
local spookyButtonCreated = false
local spookyButton = nil

local function checkSpookyTrees()
    task.spawn(function()
        while true do
            local spookyFound = nil

            for _, region in ipairs(workspace:GetChildren()) do
                if region:IsA("Model") and region.Name == "TreeRegion" then
                    for _, model in ipairs(region:GetChildren()) do
                        if model:IsA("Model") then
                            local treeClass = model:FindFirstChild("TreeClass")
                            if treeClass and treeClass:IsA("StringValue") and treeClass.Value == "Spooky" then
                                spookyFound = model
                                break
                            end
                        end
                    end
                end
                if spookyFound then break end
            end

            if spookyFound then
                spookyLabel:Set("Spooky: Available")

                if not spookyButtonCreated then
                    spookyButtonCreated = true
                    spookyButton = PlayerTab:CreateButton({
                        Name = "Teleport Spooky",
                        Callback = function()
                            local woodParts = {}
                            for _, child in ipairs(spookyFound:GetChildren()) do
                                if child:IsA("BasePart") and child.Name == "WoodSection" then
                                    table.insert(woodParts, child)
                                end
                            end

                            if #woodParts > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local targetPart = woodParts[1] -- ilk WoodSection
                                LocalPlayer.Character:SetPrimaryPartCFrame(targetPart.CFrame + Vector3.new(0,5,0))
                            else
                                warn("WoodSection bulunamadı veya karakter yok!")
                            end
                        end
                    })
                end
            else
                spookyLabel:Set("Spooky: Not Found")
                
                -- Eğer buton varsa sil
                if spookyButtonCreated and spookyButton then
                    spookyButton:Remove()
                    spookyButtonCreated = false
                    spookyButton = nil
                end
            end

            task.wait(1)
        end
    end)
end

checkSpookyTrees()

workspace.ChildAdded:Connect(function(child)
    if child.Name == "TreeRegion" then
        task.wait(1)
        checkSpookyTrees()
    end
end)


