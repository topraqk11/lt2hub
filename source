local VehicleTab = Window:CreateTab("Vehicle", "car")

VehicleTab:CreateSection("Vehicle")

local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local VehicleFolder = game.Workspace:FindFirstChild("PlayerModels")

local CurrentSpeedMultiplier = 1

VehicleTab:CreateSlider({
	Name = "Vehicle Speed",
	Range = {1, 6},
	Increment = 0.1,
	Suffix = "x",
	CurrentValue = 1,
	Callback = function(Value)
		CurrentSpeedMultiplier = Value

		if not VehicleFolder then
			warn("PlayerModels klasörü bulunamadı!")
			return
		end

		local function getOwnedVehicles()
			local owned = {}
			for _, model in ipairs(VehicleFolder:GetChildren()) do
				local driveSeat = model:FindFirstChildOfClass("VehicleSeat") or model:FindFirstChild("DriveSeat")
				local owner = model:FindFirstChild("Owner")
				local ownerString = owner and owner:FindFirstChild("OwnerString")

				if driveSeat and ownerString and ownerString.Value == player.Name then
					table.insert(owned, model)

				end
			end
			return owned
		end

		local ownedVehicles = getOwnedVehicles()
		
			for _, v in ipairs(ownedVehicles) do
				local config = v:FindFirstChild("Configuration")
				if config and config:FindFirstChild("MaxSpeed") then
					config.MaxSpeed.Value = CurrentSpeedMultiplier
				end
		end
	end,
})

